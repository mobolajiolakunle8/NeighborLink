# Project-level npm policy for Vercel / npm 11 builds.
# These are the only dependency install scripts present in this lockfile.
# Approving them by name satisfies npm's `install-scripts` advisory without
# using the discouraged `--dangerously-allow-all-scripts` blanket flag.
allow-scripts=esbuild,@firebase/util,protobufjs,sharp

# Keep deployment logs focused on actionable errors. Upstream package
# deprecation notices are non-fatal and are tracked by the dependency owners.
audit=false
fund=false
update-notifier=false
loglevel=error
